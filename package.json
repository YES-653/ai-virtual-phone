{
  "name": "ai-virtual-phone",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node --max-old-space-size=4096 scripts/local-next-server.mjs --dev",
    "build": "node scripts/build-weixin-assistant-dist.mjs && node scripts/build-personal-push-dist.mjs && node scripts/strip-api-routes.mjs && next build && node scripts/restore-backdrop-filter.mjs",
    "start": "node scripts/local-next-server.mjs --prod",
    "deploy": "npm run build && gh-pages -d out",
    "lint": "next lint",
    "check:sdk": "node scripts/check-custom-app-sdk-consistency.mjs",
    "check:weixin": "node scripts/check-weixin-prompt-equivalence.mjs",
    "check:push": "node scripts/check-personal-push-dist.mjs",
    "weixin:assistant": "node tools/weixin-local-assistant/assistant.mjs",
    "weixin:assistant:once": "node tools/weixin-local-assistant/assistant.mjs --once",
    "weixin:build-dist": "node scripts/build-weixin-assistant-dist.mjs",
    "push:build-dist": "node scripts/build-personal-push-dist.mjs",
    "build:glass-icons": "node scripts/build-glass-icons.mjs"
  },
  "dependencies": {
    "@gltf-transform/functions": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@mdi/js": "^7.4.4",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.0",
    "@supabase/realtime-js": "^2.110.7",
    "@types/three": "^0.183.1",
    "@types/web-push": "^3.6.4",
    "d3-delaunay": "^6.0.4",
    "dexie": "^4.3.0",
    "dompurify": "^3.3.3",
    "jsonrepair": "^3.13.3",
    "jszip": "^3.10.0",
    "lucide-react": "^0.575.0",
    "marked": "^17.1.0",
    "next": "^15.1.0",
    "pinyin-pro": "^3.28.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.1",
    "remark-cjk-friendly": "^2.3.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.2",
    "undici": "^7.26.0",
    "web-push": "^3.6.7"
  }
}